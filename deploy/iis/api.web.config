<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the ChessMaster API, which runs as the /api application under the site.
  deploy.ps1 copies this file to the API folder as web.config and fills in the Node and folder paths.

  HttpPlatformHandler starts Node, hands it a free port in HTTP_PLATFORM_PORT, and
  forwards every /api/... request to it with the path unchanged. If Node crashes,
  IIS starts it again on the next request.
  Requires the HttpPlatformHandler and URL Rewrite modules.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="__NODE_EXE__"
                  arguments="&quot;__API_DIR__\src\server.js&quot;"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__API_DIR__\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <!-- Don't inherit the frontend's single-page-app rewrite rule. -->
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
